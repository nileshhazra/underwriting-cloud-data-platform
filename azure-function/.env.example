# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>
SERVICE_BUS_QUEUE_NAME=policy-submissions

# Microsoft Entra ID (Azure AD) App Registration Credentials
AZURE_TENANT_ID=<your-directory-tenant-id>
AZURE_CLIENT_ID=<your-application-client-id>
AZURE_CLIENT_SECRET=<your-client-secret-value>

# Microsoft Fabric Lakehouse Target
FABRIC_WORKSPACE_NAME=ws-underwriting-analytics
FABRIC_LAKEHOUSE_NAME=lh_underwriting_bronze
